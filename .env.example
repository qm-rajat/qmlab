# Copy this file to .env and fill in real values. Never commit the actual .env file.

# --- ADMIN AUTH (required — OTP is sent only to this exact email) ---
ADMIN_EMAIL=admin@qmlabs.com
# SESSION_SECRET: random string used to sign the admin session cookie (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- REDIS STORE (server/store.ts) — server-side persistence for projects/blogs/certs/settings/contacts ---
# A standard redis:// connection string — from Vercel's Redis integration, Redis Cloud,
# Upstash, or any Redis-compatible host. Leave blank to keep running on the old
# localStorage-only fallback (single-browser only, not shared across visitors/devices).
REDIS_URL=

# --- GEMINI AI (Technical SEO Analyzer tab) ---
# Required for the /api/seo/analyze route to return live AI-generated suggestions.
# Without it, the route silently falls back to canned heuristic suggestions.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- SMTP OUTBOUND EMAIL (contact form + admin lead notifications) ---
# All four of HOST/PORT/USER/PASS must be set together or SMTP is treated as unconfigured
# and /api/contact will log the lead but skip sending any email.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Optional — falls back to SMTP_USER (the sending account) if omitted.
SMTP_TO=
SMTP_SENDER_NAME=

# --- SITE URL — used for links inside outbound emails (CRM console link, portfolio links) ---
# Defaults to https://qmlab-indol.vercel.app if unset. Update if your deploy domain changes.
SITE_URL=

# --- Runtime (usually set by the host, not needed locally) ---
# NODE_ENV=production
