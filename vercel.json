{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "server/**/*.ts",
        "src/**/*.ts",
        "src/**/*.tsx"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
