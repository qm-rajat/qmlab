@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');
@import "tailwindcss";

@theme {
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
  --color-primary: #0084ff;
  --color-primary-dark: #0052cc;
  --color-primary-light: #e6f2ff;
  --animate-float: float 4s ease-in-out infinite;
  --animate-glow-ring: glow-ring 6s linear infinite;
}

/* Custom CSS Keyframes */
@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8px);
  }
}

@keyframes glow-ring {
  0% {
    transform: rotate(0deg) scale(1);
    opacity: 0.7;
  }
  50% {
    transform: rotate(180deg) scale(1.05);
    opacity: 1;
  }
  100% {
    transform: rotate(360deg) scale(1);
    opacity: 0.7;
  }
}

/* Custom glow effect */
.blue-glow-border {
  border: 1px solid rgba(0, 132, 255, 0.2);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.blue-glow-border:hover {
  border-color: rgba(0, 132, 255, 0.7);
  box-shadow: 0 0 15px rgba(0, 132, 255, 0.15);
}

/* Advanced grid styling */
.tech-grid-pattern {
  background-size: 30px 30px;
  background-image: 
    linear-gradient(to right, rgba(0, 132, 255, 0.03) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(0, 132, 255, 0.03) 1px, transparent 1px);
}

/* Custom Webkit scrollbar styling */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: #f8fafc;
}

::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* Scrollbar hidden utility */
.scrollbar-none::-webkit-scrollbar {
  display: none;
}
.scrollbar-none {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}

/* Beautiful custom prose simulation for Blog rendering */
.blog-prose h3 {
  font-size: 1.5rem;
  font-weight: 700;
  color: #0f172a;
  margin-top: 1.75rem;
  margin-bottom: 0.75rem;
}

.blog-prose p {
  line-height: 1.8;
  color: #334155;
  margin-bottom: 1.25rem;
}

.blog-prose blockquote {
  border-left: 4px solid #0084ff;
  color: #475569;
  font-style: italic;
  font-size: 1.125rem;
  padding-left: 1rem;
  margin: 1.5rem 0;
  background-color: #f8fafc;
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  border-radius: 0 0.5rem 0.5rem 0;
}

.blog-prose ul {
  list-style-type: disc;
  padding-left: 1.5rem;
  margin-bottom: 1.25rem;
}

.blog-prose li {
  margin-bottom: 0.5rem;
  color: #334155;
}

.blog-prose code {
  font-family: var(--font-mono);
  background: #f1f5f9;
  color: #e21d48;
  padding: 0.125rem 0.25rem;
  border-radius: 0.25rem;
  font-size: 0.875rem;
}

.blog-prose pre {
  background: #1e293b;
  color: #f8fafc;
  padding: 1rem;
  border-radius: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.875rem;
  overflow-x: auto;
  margin-bottom: 1.5rem;
  border: 1px solid #334155;
}

.blog-prose pre code {
  background: transparent;
  color: inherit;
  padding: 0;
}

/* Printable styles for direct PDF export */
@media print {
  body {
    background: white !important;
    color: black !important;
    font-size: 12px;
  }
  .no-print {
    display: none !important;
  }
  .print-only {
    display: block !important;
  }
  .print-page {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    box-shadow: none !important;
    border: none !important;
  }
  a {
    text-decoration: underline !important;
    color: black !important;
  }
}
